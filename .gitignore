# ============================================================================
# PE-Portal Root .gitignore
# ============================================================================

# Environment variables & secrets
.env
*.env
!.env.example

# Compiled binaries & builds
backend/server
backend/bin/
bin/
dist/
dist-ssr/
frontend/dist/
desktop/dist/
desktop/src-tauri/target/

# Dependencies
node_modules/
frontend/node_modules/
desktop/node_modules/
.node/
vendor/

# Local database & uploaded media storage
data/
uploads/
/data/
*.db
*.sqlite

# IDE & OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
*.log
logs/

# Scratch & temporary agent logs
scratch/
.tempmediaStorage/
.codegraph/
